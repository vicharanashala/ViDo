# ViDo Firebase configuration
#
# Copy this file to .env.local. The defaults below keep authentication on the
# local emulator suite. Tasks, calendar events, categories, and planning targets
# are stored by the NestJS backend (see VITE_BACKEND_TYPE below).

# Keep the emulators (Auth :9099, Firestore :8080) local. Set to "false" only
# when supplying a real Firebase web app configuration.
VITE_USE_FIREBASE_EMULATOR=true

# Emulator endpoints (must match firebase.json).
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080

# Demo project values used by the emulators. No real Google credentials needed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-vido
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==============================================================================
# Backend Architecture Configuration
# ==============================================================================
# Options:
#   "nestjs" - Connects to the local NestJS backend API on port 3001
#   "mock"   - Uses browser-based MockTeamRepository with dev server sync bridge
VITE_BACKEND_TYPE=nestjs

# Custom API base URL (defaults to '' using Vite proxy to http://localhost:3001)
VITE_API_URL=

# ==============================================================================
# Supabase Integration (Optional - for production BaaS)
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
