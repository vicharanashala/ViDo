datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Team {
  id          String           @id @default(uuid())
  name        String
  description String
  leadId      String
  leadEmail   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members     TeamMember[]
  invitations TeamInvitation[]
  milestones  TeamMilestone[]
  tasks       TeamTask[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  email     String
  name      String
  role      String   // "lead" | "member"
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
}

model TeamInvitation {
  id           String   @id @default(uuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamName     String
  inviterId    String
  inviterName  String
  inviterEmail String
  inviteeEmail String
  status       String   @default("pending") // "pending" | "accepted" | "rejected"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeamMilestone {
  id         String     @id @default(uuid())
  teamId     String
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title      String
  targetDate String
  status     String     @default("upcoming") // "completed" | "active" | "upcoming"
  orderIndex Int
  createdAt  DateTime   @default(now())
  tasks      TeamTask[]
}

model TeamTask {
  id            String           @id @default(uuid())
  teamId        String
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  milestoneId   String?
  milestone     TeamMilestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title         String
  description   String
  deadline      String
  priority      String           // "low" | "medium" | "high" | "urgent"
  status        String           @default("active") // "active" | "completed"
  progress      Int              @default(0) // 0 - 100
  assigneeId    String
  assigneeName  String
  assigneeEmail String
  leadId        String
  createdAt     DateTime         @default(now())
  completedAt   DateTime?
  checkpoints   TaskCheckpoint[]
}

model TaskCheckpoint {
  id         String   @id @default(uuid())
  taskId     String
  task       TeamTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  timestamp  DateTime @default(now())
  progress   Int
  note       String
}

model UserTask {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   String?
  dueDate     String
  dueTime     String?
  priority    String    @default("medium") // "low" | "medium" | "high"
  category    String    @default("personal") // "personal" | "home" | "work" | custom
  state       String    @default("active") // "active" | "completed" | "archived"
  completedAt DateTime?
  checkpoints String?   // JSON serialized checkpoints [{ id, timestamp, note }]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model UserCalendarEvent {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String?
  date         String   // YYYY-MM-DD
  time         String?  // HH:MM
  endTime      String?  // HH:MM
  linkedTaskId String?
  source       String   @default("calendar")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model UserCustomCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model UserPlanningTargets {
  userId    String   @id
  weekly    Int      @default(15)
  monthly   Int      @default(60)
  updatedAt DateTime @updatedAt
}

